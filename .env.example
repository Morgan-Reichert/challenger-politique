# ─── Challenger Politique ────────────────────────────────────────────────────
# Aucune authentification : le service est ouvert. Les appels au modèle sont
# limités par adresse IP (empreinte salée, jamais stockée en clair).
POL_SEL_IP=une-chaine-aleatoire-longue
# CHAT_RATE_LIMIT_PER_MIN=30
# CHAT_FREE_DAILY_LIMIT=20

# ─── Supabase (base propre à Challenger Politique : corpus + quotas) ─────────
# Le corpus vit dans des tables préfixées pol_ (voir supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Modèle (SERVEUR UNIQUEMENT) ─────────────────────────────────────────────
MISTRAL_API_KEY=
# Gemini (prioritaire si définie) — clé Google AI Studio avec l'API Generative Language autorisée
GEMINI_API_KEY=
GEMINI_MODELE=gemini-2.5-flash
# Recherche web d'appoint (optionnelle). Le corpus reste la source principale.
TAVILY_API_KEY=

