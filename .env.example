# ─── Challenger Politique ────────────────────────────────────────────────────
# Authentification : MÊME projet Firebase que Challenger IA. Les comptes sont
# partagés — un utilisateur Challenger se connecte ici sans nouvelle inscription.
# Penser à ajouter le domaine de cette app dans
# Firebase Console > Authentication > Settings > Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SERVEUR — vérification des ID tokens (mêmes valeurs que Challenger IA)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Supabase (même projet que Challenger : crédits partagés) ─────────────────
# Le corpus vit dans des tables préfixées pol_ (voir supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Modèle (SERVEUR UNIQUEMENT) ─────────────────────────────────────────────
MISTRAL_API_KEY=
# Gemini (prioritaire si définie) — clé Google AI Studio avec l'API Generative Language autorisée
GEMINI_API_KEY=
GEMINI_MODELE=gemini-2.5-flash
# Recherche web d'appoint (optionnelle). Le corpus reste la source principale.
TAVILY_API_KEY=

# Coût en crédits Challenger par opération
POL_COUT_ANALYSE=1
POL_COUT_QUESTION=1
POL_COUT_FAISABILITE=2
